# Local secrets are stored in .env, which is ignored by Git and must be 0600.
MIMIR_CHAT_ADMIN_TOKEN=

# Public Google desktop OAuth client embedded in Mimir builds. End users do not
# enter these values. Google issues a client secret for desktop clients, but it
# is not treated as a confidential secret in an installed application.
MIMIR_GOOGLE_OAUTH_CLIENT_ID=
MIMIR_GOOGLE_OAUTH_CLIENT_SECRET=

# Enter each user's Slack personal token in Mimir Settings after installation.
# Mimir stores it in the OS keychain. Never put a Slack token in this file.

# macOS Developer ID signing and Apple notarization.
APPLE_CERTIFICATE=
APPLE_CERTIFICATE_PASSWORD=
APPLE_SIGNING_IDENTITY=
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=

# Tauri updater signing. CI stores the private key and password as repository
# secrets. Local macOS builds can use ~/.config/mimir/release/updater.key and
# the com.abundanceds.mimir.updater-signing login-keychain item instead.
TAURI_SIGNING_PRIVATE_KEY_PATH=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Parked Windows Azure Artifact Signing recovery material.
# These values are not consumed by an active release job.
AZURE_CODESIGN_ENDPOINT=
AZURE_CODESIGN_ACCOUNT=
AZURE_CERT_PROFILE_NAME=
AZURE_CODESIGN_PUBLISHER=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Parked Azure administration context; not consumed by the release build.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=
