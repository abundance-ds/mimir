# Local secrets are stored in .env, which is ignored by Git and must be 0600.
MIMIR_CHAT_ADMIN_TOKEN=

# macOS Developer ID signing and Apple notarization.
APPLE_CERTIFICATE=
APPLE_CERTIFICATE_PASSWORD=
APPLE_SIGNING_IDENTITY=
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=

# Parked Windows Azure Artifact Signing recovery material.
# These values are not consumed by an active release job.
AZURE_CODESIGN_ENDPOINT=
AZURE_CODESIGN_ACCOUNT=
AZURE_CERT_PROFILE_NAME=
AZURE_CODESIGN_PUBLISHER=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Parked Azure administration context; not consumed by the release build.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=
