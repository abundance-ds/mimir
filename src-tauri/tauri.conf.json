{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mim Panel",
  "version": "0.0.1",
  "identifier": "dev.mim.panel",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "resources/profile.json",
      "resources/bundled-skills",
      "resources/bundled-apps"
    ],
    "externalBin": ["binaries/docx-worker", "binaries/typst"],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "mimeType": "text/markdown",
        "description": "Markdown Document"
      },
      {
        "ext": ["txt"],
        "mimeType": "text/plain",
        "description": "Text Document"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyQ0YwMzUyMDNFMkE1NUEKUldSYXBlSURVZ1BQa3Z1OEFCVU1lZG1IZlltYmtiVTl0MGMwOVM0cnVDWnhHS0hHQnY0U1lYd3QK",
      "endpoints": [
        "https://mim.dev/api/updates/latest.json"
      ]
    }
  }
}
