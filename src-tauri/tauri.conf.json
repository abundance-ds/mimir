{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mimir",
  "version": "0.3.0",
  "identifier": "com.abundanceds.mimir",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "vendor/THIRD_PARTY_NOTICES.md",
      "vendor/THIRD_PARTY_LICENSES.md",
      "vendor/SBOM.spdx.json"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "mimeType": "text/markdown",
        "description": "Markdown Document"
      },
      {
        "ext": [
          "txt"
        ],
        "mimeType": "text/plain",
        "description": "Text Document"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "14.2",
      "entitlements": "./Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlENzdGNDhDMDRFNzFGRkQKUldUOUgrY0VqUFIzbllnRmZKWWN5d2tMR1VGNEx6QldSdDhTUGkzbnJrbmF1RHlBOUplRFBVWUsK",
      "endpoints": [
        "https://github.com/abundance-ds/mimir/releases/latest/download/latest.json"
      ]
    }
  }
}
